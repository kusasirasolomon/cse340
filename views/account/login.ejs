<%- include("../partials/head") %>

    <body>
        <%- include("../partials/header") %>
            <%- nav %>
                <main>
                    <h1>Login</h1>

                    <% if (messages.success) { %>
                        <p class="flash-success">
                            <%= messages.success %>
                        </p>
                        <% } %>
                            <% if (messages.error) { %>
                                <p class="flash-error">
                                    <%= messages.error %>
                                </p>
                                <% } %>

                                    <% if (errors && errors.length> 0) { %>
                                        <ul class="errors">
                                            <% errors.forEach(e=> { %><li>
                                                    <%= e.msg %>
                                                </li>
                                                <% }) %>
                                        </ul>
                                        <% } %>

                                            <form action="/account/login" method="POST" novalidate>
                                                <label>Email:
                                                    <input type="email" name="account_email"
                                                        value="<%= account_email %>" required>
                                                </label>
                                                <label>Password:
                                                    <input type="password" name="account_password" required>
                                                </label>
                                                <button type="submit">Login</button>
                                            </form>
                                            <p>Don't have an account? <a href="/account/register">Register here</a></p>
                </main>
                <%- include("../partials/footer") %>
    </body>

    </html>