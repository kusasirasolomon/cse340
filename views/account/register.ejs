<%- include("../partials/head") %>

    <body>
        <%- include("../partials/header") %>
            <%- nav %>
                <main>
                    <h1>Register</h1>

                    <% if (messages.error) { %>
                        <p class="flash-error">
                            <%= messages.error %>
                        </p>
                        <% } %>

                            <% if (errors && errors.length> 0) { %>
                                <ul class="errors">
                                    <% errors.forEach(e=> { %><li>
                                            <%= e.msg %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <% } %>

                                    <form action="/account/register" method="POST" novalidate>
                                        <label>First Name:
                                            <input type="text" name="account_firstname" value="<%= account_firstname %>"
                                                required>
                                        </label>
                                        <label>Last Name:
                                            <input type="text" name="account_lastname" value="<%= account_lastname %>"
                                                required>
                                        </label>
                                        <label>Email:
                                            <input type="email" name="account_email" value="<%= account_email %>"
                                                required>
                                        </label>
                                        <label>Password:
                                            <input type="password" name="account_password"
                                                pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
                                                title="Min 12 chars, must include uppercase, lowercase, number and special character"
                                                required>
                                        </label>
                                        <p><em>Password must be at least 12 characters and include uppercase, lowercase,
                                                number and special character.</em></p>
                                        <button type="submit">Register</button>
                                    </form>
                                    <p>Already have an account? <a href="/account/login">Login here</a></p>
                </main>
                <%- include("../partials/footer") %>
    </body>

    </html>