<%- include("../partials/head") %>

    <body>
        <%- include("../partials/header") %>
            <%- nav %>
                <main>
                    <h1>
                        <%= title %>
                    </h1>

                    <% if (messages.error) { %>
                        <p class="flash-error">
                            <%= messages.error %>
                        </p>
                        <% } %>

                            <% if (errors && errors.length> 0) { %>
                                <ul class="errors">
                                    <% errors.forEach(e=> { %><li>
                                            <%= e.msg %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <% } %>

                                    <form action="/inv/edit" method="POST" novalidate>
                                        <input type="hidden" name="inv_id" value="<%= inv_id %>">

                                        <label>Make:
                                            <input type="text" name="inv_make" value="<%= inv_make %>" required>
                                        </label>
                                        <label>Model:
                                            <input type="text" name="inv_model" value="<%= inv_model %>" required>
                                        </label>
                                        <label>Year:
                                            <input type="number" name="inv_year" value="<%= inv_year %>" minlength="4"
                                                maxlength="4" required>
                                        </label>
                                        <label>Price:
                                            <input type="number" name="inv_price" value="<%= inv_price %>" min="0"
                                                step="0.01" required>
                                        </label>
                                        <label>Mileage:
                                            <input type="number" name="inv_miles" value="<%= inv_miles %>" min="0"
                                                required>
                                        </label>
                                        <label>Color:
                                            <input type="text" name="inv_color" value="<%= inv_color %>" required>
                                        </label>
                                        <label>Description:
                                            <textarea name="inv_description" required><%= inv_description %></textarea>
                                        </label>
                                        <label>Image Path:
                                            <input type="text" name="inv_image" value="<%= inv_image %>">
                                        </label>
                                        <label>Thumbnail Path:
                                            <input type="text" name="inv_thumbnail" value="<%= inv_thumbnail %>">
                                        </label>
                                        <label>Classification:
                                            <%- classificationList %>
                                        </label>

                                        <button type="submit">Update Vehicle</button>
                                    </form>
                </main>
                <%- include("../partials/footer") %>
    </body>

    </html>