<%- include("../partials/head") %>

    <body>
        <%- include("../partials/header") %>
            <%- nav %>
                <main>
                    <h1>
                        <%= title %>
                    </h1>

                    <% if (messages.error) { %>
                        <p class="flash-error">
                            <%= messages.error %>
                        </p>
                        <% } %>

                            <div class="delete-confirm">
                                <p>Are you sure you want to delete this vehicle?</p>

                                <div class="vehicle-summary">
                                    <p><strong>Make:</strong>
                                        <%= inv_make %>
                                    </p>
                                    <p><strong>Model:</strong>
                                        <%= inv_model %>
                                    </p>
                                    <p><strong>Year:</strong>
                                        <%= inv_year %>
                                    </p>
                                    <p><strong>Price:</strong> $<%= new Intl.NumberFormat('en-US').format(inv_price) %>
                                    </p>
                                </div>

                                <form action="/inv/delete" method="POST">
                                    <input type="hidden" name="inv_id" value="<%= inv_id %>">
                                    <button type="submit" class="btn-delete-confirm">Yes, Delete</button>
                                    <a href="/inv/" class="btn-cancel">Cancel</a>
                                </form>
                            </div>
                </main>
                <%- include("../partials/footer") %>
    </body>

    </html>